SHELL := /bin/sh

# Override these when needed, for example: make download ACCESSION=NM_000546
DB ?= nuccore
FASTA_OUT ?= $(ACCESSION).fasta
GFF_OUT ?= $(ACCESSION).gff
NCBI_EFETCH := https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi
NCBI_SVIEWER := https://www.ncbi.nlm.nih.gov/sviewer/viewer.fcgi

.PHONY: download clean

download:
	@test -n "$(ACCESSION)" || { echo "Usage: make download ACCESSION=<accession> [DB=nuccore] [FASTA_OUT=file] [GFF_OUT=file]" >&2; exit 1; }
	@tmpdir=$$(mktemp -d); \
		trap 'rm -rf "$$tmpdir"' EXIT INT TERM; \
		set -e; \
		curl --fail --location --retry 3 --retry-delay 2 \
		--get "$(NCBI_EFETCH)" \
		--data-urlencode "db=$(DB)" \
		--data-urlencode "id=$(ACCESSION)" \
		--data-urlencode "rettype=fasta" \
		--data-urlencode "retmode=text" \
		--output "$$tmpdir/sequence.fasta"; \
		curl --fail --location --retry 3 --retry-delay 2 \
			--get "$(NCBI_SVIEWER)" \
			--data-urlencode "id=$(ACCESSION)" \
			--data-urlencode "db=$(DB)" \
			--data-urlencode "report=gff3" \
			--data-urlencode "retmode=text" \
			--output "$$tmpdir/annotations.gff"; \
		mv "$$tmpdir/sequence.fasta" "$(FASTA_OUT)"; \
		mv "$$tmpdir/annotations.gff" "$(GFF_OUT)"
	@echo "Downloaded $(ACCESSION) to $(FASTA_OUT) and $(GFF_OUT)"

clean:
	@test -n "$(ACCESSION)" || { echo "Usage: make clean ACCESSION=<accession> [FASTA_OUT=file] [GFF_OUT=file]" >&2; exit 1; }
	@rm -f "$(FASTA_OUT)" "$(GFF_OUT)"
