SHELL := /bin/sh

# Override these when needed, for example: make download ACCESSION=GCF_000005845.2
FASTA_OUT ?= $(ACCESSION).fasta
GFF_OUT ?= $(ACCESSION).gff
NCBI_DATASETS := https://api.ncbi.nlm.nih.gov/datasets/v2/genome/accession

.PHONY: download clean

download:
	@test -n "$(ACCESSION)" || { echo "Usage: make download ACCESSION=<assembly-accession> [FASTA_OUT=file] [GFF_OUT=file]" >&2; exit 1; }
	@tmpdir=$$(mktemp -d); \
		trap 'rm -rf "$$tmpdir"' EXIT INT TERM; \
		set -e; \
		curl --fail --location --retry 5 --retry-all-errors --retry-delay 5 \
			--output "$$tmpdir/genome.zip" \
			"$(NCBI_DATASETS)/$(ACCESSION)/download?include_annotation_type=GENOME_FASTA,GENOME_GFF"; \
		unzip -p "$$tmpdir/genome.zip" '*genomic.fna' > "$$tmpdir/sequence.fasta"; \
		unzip -p "$$tmpdir/genome.zip" '*genomic.gff' > "$$tmpdir/annotations.gff"; \
		mv "$$tmpdir/sequence.fasta" "$(FASTA_OUT)"; \
		mv "$$tmpdir/annotations.gff" "$(GFF_OUT)"
	@echo "Downloaded $(ACCESSION) to $(FASTA_OUT) and $(GFF_OUT)"

clean:
	@test -n "$(ACCESSION)" || { echo "Usage: make clean ACCESSION=<assembly-accession> [FASTA_OUT=file] [GFF_OUT=file]" >&2; exit 1; }
	@rm -f "$(FASTA_OUT)" "$(GFF_OUT)"
